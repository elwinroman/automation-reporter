APP_VERSION=latest
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Ruta del host donde viven los logs de TestComplete. Puede ser relativa a la raiz del repo o absoluta.
LOGS_HOST_PATH=D:\shared\pruebas

# Ruta dentro del contenedor que consume el backend.
BACKEND_LOGS_DIRECTORY=/data/logs

# Variables del frontend en tiempo de build.
VITE_TRPC_URL=/
VITE_REPORTS_BASE_URL=http://localhost:9001

# Dejar vacio para permitir todos los origenes. Si nginx hace proxy al backend, puede quedar vacio.
ALLOWED_URLS=
